[Unit]
Description=Website Backend
After=network.target

[Service]
Type=simple
User=website
WorkingDirectory=/opt/website
LimitNOFILE=65535
EnvironmentFile=/opt/website/config/connection.conf

ExecStart=/usr/bin/java -Xms256m -Xmx512m -Duser.timezone=Asia/Shanghai \
  -DLOG_PATH=/opt/website/logs \
  -Druoyi.profile=/opt/website/uploadPath \
  -jar /opt/website/website.jar \
  --spring.config.additional-location=optional:file:/opt/website/config/ \
  --server.forward-headers-strategy=framework

SuccessExitStatus=143
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
