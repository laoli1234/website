# 统一换行符，保证 Windows 打包出来的脚本和配置能在 Linux 上直接运行。
# Git 仓库内统一存 LF；Windows 工作区也按 LF 检出这些文件。

.gitattributes text eol=lf
.gitignore     text eol=lf

*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf

# 前端源码、静态页和资源统一 LF，保证 Windows 与 Linux 打出的前端一致
*.html    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.vue     text eol=lf
*.svg     text eol=lf
*.ts      text eol=lf

# Windows 脚本保留 CRLF（PowerShell 5.1 也能读 LF，但 CRLF 更稳妥）
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制文件不做换行符转换
*.jar     binary
*.zip     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
